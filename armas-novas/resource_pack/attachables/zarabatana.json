{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minemods:zarabatana",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/items/zarabatana",
        "mirando": "textures/items/zarabatana_mirando"
      },
      "geometry": {
        "default": "geometry.minemods.zarabatana",
        "mirando": "geometry.minemods.zarabatana_mirando"
      },
      "animations": {
        "wield": "animation.bow.wield",
        "wield_first_person_pull": "animation.bow.wield_first_person_pull"
      },
      "scripts": {
        "pre_animation": [
          "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / 10.0, 0.0, 1.0f);",
          "variable.mirando = query.main_hand_item_use_duration > 0.0f;"
        ],
        "animate": [
          "wield",
          {
            "wield_first_person_pull": "query.main_hand_item_use_duration > 0.0f && c.is_first_person"
          }
        ]
      },
      "render_controllers": [ "controller.render.minemods.zarabatana" ]
    }
  }
}
